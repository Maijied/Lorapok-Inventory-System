[mysqld]
# Lorapok Retail — tuned for database-per-tenant on a disk-constrained dev host.
innodb_buffer_pool_size = 256M
# One DB per shop means many small schemas; keep per-table files so a dropped
# tenant actually returns its disk.
innodb_file_per_table   = 1
# Dev only: binlogs are pure overhead here and grow fast with many tenant DBs.
disable_log_bin
max_connections         = 200
